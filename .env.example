# ==============================================================================
# OpenHostMC Environment Configuration
# ==============================================================================

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# ------------------------------------------------------------------------------
# Database & Persistence (PostgreSQL)
# ------------------------------------------------------------------------------
# Standard format: postgresql://<user>:<password>@<host>:<port>/<dbname>?schema=public
# Use 'localhost' for local development or 'postgres' when running inside Docker network
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/openhostmc?schema=public

# ------------------------------------------------------------------------------
# Authentication & Security
# ------------------------------------------------------------------------------
# Secret key for signing JWT tokens (MUST be changed in production!)
JWT_SECRET=change-this-jwt-secret-in-production-min-32-chars

# Default superadmin bootstrap credentials (created on initial launch)
SUPERADMIN_EMAIL=admin@openhostmc.it
SUPERADMIN_PASSWORD=change-me-superadmin-password

# ------------------------------------------------------------------------------
# Orchestrator Service Configuration
# ------------------------------------------------------------------------------
# HTTP port for orchestrator API (defaults to 3002)
PORT=3002

# External URL for orchestrator service (accessible by frontend/browser)
ORCHESTRATOR_URL=http://localhost:3002

# Internal URL for orchestrator service (used for server-side Next.js proxy rewrites)
ORCHESTRATOR_INTERNAL_URL=http://localhost:3002

# Allowed CORS origins (comma-separated, supports wildcards like * or *.example.com)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# Redis Cache & Message Queue
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# Minecraft Server Storage & Docker Management
# ------------------------------------------------------------------------------
# Path where Minecraft server data directories are stored
SERVER_DATA_PATH=./servers

# If running orchestrator inside Docker with Docker-out-of-Docker (DooD), set to host absolute path
HOST_DATA_PATH=

# ------------------------------------------------------------------------------
# Object Storage (MinIO / S3)
# ------------------------------------------------------------------------------
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME_SECRET
