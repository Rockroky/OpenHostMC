{
  "name": "openhostmc-monorepo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "start": "npx prisma db push --schema=packages/database/prisma/schema.prisma --accept-data-loss && npx concurrently \"cross-env PORT=3005 npm run start:prod --workspace=apps/orchestrator-service\" \"cross-env PORT=3000 HOSTNAME=0.0.0.0 npm run start --workspace=apps/frontend\"",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "node -r ts-node/register packages/database/prisma/seed.ts",
    "test:server-management": "node test-server-management.js"
  },
  "devDependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^5.22.0",
    "pg": "^8.21.0",
    "prettier": "^3.7.4",
    "prisma": "^5.22.0",
    "turbo": "^2.9.16",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@11.12.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
